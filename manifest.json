{
  "manifest_version": 3,
  "name": "LinkedIn Feed Blocker",
  "version": "1.1.0",
  "description": "Disables LinkedIn's main feed while keeping the rest of LinkedIn usable.",

  "permissions": [
    "declarativeNetRequest"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*"
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "linkedin_feed_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "css": [
        "feed.css"
      ],
      "run_at": "document_start"
    }
  ]
}